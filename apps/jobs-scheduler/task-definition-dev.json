{
  "family": "es-jp-devv2-job-scheduler",
  "taskRoleArn": "arn:aws:iam::540464586484:role/ecsTaskExecutionRole",
  "executionRoleArn": "arn:aws:iam::540464586484:role/ecsTaskExecutionRole",
  "networkMode": "bridge",
  "containerDefinitions": [
    {
      "logConfiguration": {
